<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: a stylised "F" window glyph on the 108dp canvas.
  The safe zone is the centre 72dp, so the art stays within roughly x/y 36..72.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Window frame -->
    <path
        android:pathData="M34,32 h40 a3,3 0 0 1 3,3 v38 a3,3 0 0 1 -3,3 h-40 a3,3 0 0 1 -3,-3 v-38 a3,3 0 0 1 3,-3 z"
        android:strokeColor="#65DDB4"
        android:strokeWidth="3.5"
        android:fillColor="#00000000" />

    <!-- Title bar -->
    <path
        android:pathData="M31,41 h46"
        android:strokeColor="#65DDB4"
        android:strokeWidth="3.5" />

    <!-- Letter F inside the window body -->
    <path
        android:pathData="M45,49 h18 M45,49 v20 M45,58 h12"
        android:strokeColor="#65DDB4"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />
</vector>
