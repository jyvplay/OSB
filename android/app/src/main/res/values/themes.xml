<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Plain platform theme. Compose does not need AppCompat or Material
      Components, so this avoids pulling either dependency in. The window
      background matches the Compose desktop colour so there is no white
      flash between the splash and first frame.
    -->
    <style name="Theme.FusionShell" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fusion_bg</item>
        <item name="android:statusBarColor">@color/fusion_panel</item>
        <item name="android:navigationBarColor">@color/fusion_panel</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
