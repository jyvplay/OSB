<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Library modules contribute their own permissions via manifest merge:
        :feature:capture  -> FOREGROUND_SERVICE, FOREGROUND_SERVICE_MEDIA_PROJECTION, POST_NOTIFICATIONS
        :feature:lens     -> CAMERA
        app/src/pro      -> READ_SMS, SEND_SMS (not in play)
        :cast:dlna        -> ACCESS_WIFI_STATE, CHANGE_WIFI_MULTICAST_STATE
      Declared here: networking (browser, cast, media server) and the image list.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.FusionShell"
        android:usesCleartextTraffic="true">
        <!--
          Existing experimental AirPlay/DLNA control paths require plain HTTP.
          This manifest flag is application-wide, NOT a LAN-only security boundary.
          The automatic SAF HTTP server is disabled. A per-transport LAN allowlist,
          receiver trust UI and network security review remain release blockers.
        -->
        <activity android:name=".PngCopyActivity" android:exported="false" />
        <!-- R28: detection-only USB attach/detach alerts (verdict text + private
             record + notification-if-permitted; never blocks). Registered here, NOT
             in :core:security's manifest, so the no-INTERNET privacy companion
             keeps its exact component/permission scope. POST_NOTIFICATIONS already
             merges from :feature:capture. -->
        <receiver android:name=".UsbWatchReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
                <action android:name="android.hardware.usb.action.USB_DEVICE_DETACHED" />
            </intent-filter>
        </receiver>
        <!--
          No launchMode="singleTask": ActivityScenario (used by the instrumented
          smoke test) is unreliable with singleTask. Home-role relaunch still
          behaves correctly because the activity restores its own state.
        -->
        <activity
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Optional Home role: the user must explicitly choose it. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Receive text shared from other apps (Continuity window). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
