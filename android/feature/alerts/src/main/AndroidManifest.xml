<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          Declaration per NotificationListenerService docs: exported=false plus the
          BIND_NOTIFICATION_LISTENER_SERVICE permission and the SERVICE_INTERFACE filter.
          Pilot: component disabled until encrypted history and privacy review pass.
        -->
        <service
            android:name="dev.fusion.alerts.FusionNotificationListener"
            android:exported="false"
            android:enabled="false"
            android:label="Fusion Alerts"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
